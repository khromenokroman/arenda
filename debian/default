# Параметры службы arenda. После изменения: systemctl restart arenda
#
# --host 0.0.0.0    доступ из локальной сети (вход по паролю; пароли идут по HTTP без шифрования,
#                   поэтому только доверенная сеть)
# --host 127.0.0.1  только с этой машины
# --port            порт HTTP
ARENDA_OPTS="--host 0.0.0.0 --port 8080"

