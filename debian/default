# Параметры службы arenda. После изменения: systemctl restart arenda
#
# --host 127.0.0.1  только с этой машины (по умолчанию: входа по паролю пока нет)
# --host 0.0.0.0    доступ из локальной сети: справочники и договоры увидит любой в сети
# --port            порт HTTP
ARENDA_OPTS="--host 127.0.0.1 --port 8080"

